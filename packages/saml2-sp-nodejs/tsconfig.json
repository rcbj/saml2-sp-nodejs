{
  // Compiles src/*.ts to dist/*.js and dist/*.d.ts. The sources import each other with a .ts
  // extension so Node runs them as they are (the tests, the demo and the configuration script do);
  // rewriteRelativeImportExtensions turns those into .js in what is published, and
  // erasableSyntaxOnly keeps every file runnable by Node's type stripping.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
